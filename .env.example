# Configuration GalSen IA — copier en .env et modifier
# ATTENTION : ne jamais committer ce fichier !

# ---------------------------------------------------------------------------
# Stockage
# ---------------------------------------------------------------------------
# Backend de stockage : "sqlite" (persistant) ou "in-memory" (volatile)
GALSEN_STORAGE_BACKEND=sqlite

# ---------------------------------------------------------------------------
# Sécurité API
# ---------------------------------------------------------------------------
# Clés API autorisées, séparées par des virgules.
# Format : cle[:role[:sujet]] — le rôle vaut "user" par défaut, le sujet
# "anonymous" (ADR-010). Le sujet nomme le porteur : il apparaît dans /auth/whoami,
# dans l'inventaire des clés et dans les traces d'audit. Jamais la clé.
# Rôles : admin, operator, user, readonly.
GALSEN_API_KEYS=cle-admin:admin:awa,cle-terrain:user:moussa

# ---------------------------------------------------------------------------
# Limiteur de taux
# ---------------------------------------------------------------------------
# Active/désactive le limiteur de taux ("true"/"false")
GALSEN_RATE_LIMIT_ENABLED=true

# Requêtes par minute pour les clients authentifiés (clé API valide)
GALSEN_RATE_LIMIT_AUTHENTICATED_RPM=60

# Requêtes par minute pour les clients non authentifiés (par IP)
GALSEN_RATE_LIMIT_UNAUTHENTICATED_RPM=30

# Multiplicateur de rafale (pics temporaires autorisés au-dessus de la limite RPM)
GALSEN_RATE_LIMIT_BURST_MULTIPLIER=2.0

# ---------------------------------------------------------------------------
# Ports
# ---------------------------------------------------------------------------
# Port HTTP du Cerveau local (`serveur_cerveau.py`). L'API en docker-compose ne
# publie plus de port : elle n'est joignable qu'à travers Caddy (ADR-012).
GALSEN_PORT=8000

# Port HTTP du service de développement (profil `dev` de docker-compose)
GALSEN_DEV_PORT=8001

# ---------------------------------------------------------------------------
# Fournisseurs de modèles IA
# ---------------------------------------------------------------------------
# OpenAI
OPENAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Serveur compatible OpenAI — vLLM, LM Studio, llama.cpp, LocalAI, OpenRouter,
# Groq, Together, ou votre propre serveur loué. Un seul fournisseur pour tous :
# seule l'URL change quand vous déménagez le modèle (ADR-003).
GALSEN_OPENAI_COMPATIBLE_URL=
# Clé, seulement si le service en exige une (un serveur local n'en demande pas)
GALSEN_OPENAI_COMPATIBLE_KEY=
# Fenêtre de contexte annoncée. /v1/models ne la donne pas ; 8192 par défaut,
# ce qui est le minimum accepté par le sélecteur.
GALSEN_OPENAI_COMPATIBLE_CONTEXT=

# Google (Gemini)
GOOGLE_API_KEY=

# Ollama (modèles locaux) — URL du serveur, ex: http://host.docker.internal:11434
OLLAMA_HOST=

# ---------------------------------------------------------------------------
# Dépendances optionnelles des outils
# ---------------------------------------------------------------------------
# Pour l'outil OCR (pytesseract) : chemin vers l'exécutable Tesseract
# TESSERACT_CMD=/usr/bin/tesseract

# Pour l'outil GitHub : token d'accès personnel
# GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Messagerie (connecteur e-mail SMTP — ADR-007)
# ---------------------------------------------------------------------------
# Seul l'hôte est indispensable : un relais interne peut n'exiger aucune
# authentification. Sans GALSEN_SMTP_HOST, le connecteur se déclare simplement
# "non configuré" et la plateforme fonctionne normalement.
#
# Exemple pour Gmail : host=smtp.gmail.com, security=starttls, port=587,
# et un « mot de passe d'application », jamais le mot de passe du compte.
GALSEN_SMTP_HOST=
# Laisser vide pour déduire le port du mode de sécurité (587, 465 ou 25)
GALSEN_SMTP_PORT=
GALSEN_SMTP_USER=
GALSEN_SMTP_PASSWORD=
# Adresse d'expédition ; à défaut, GALSEN_SMTP_USER est utilisé
GALSEN_SMTP_SENDER=
# starttls (défaut, recommandé) | ssl | none
GALSEN_SMTP_SECURITY=

# ---------------------------------------------------------------------------
# Vision — détection de visages (optionnel)
# ---------------------------------------------------------------------------
# Chemin d'un fichier de cascade de Haar OpenCV
# (haarcascade_frontalface_default.xml). Les distributions
# `opencv-python-headless` récentes ne le livrent plus. Sans ce fichier, la
# détection de visages se déclare indisponible au lieu de répondre « aucun
# visage », ce qui serait un faux négatif présenté comme un résultat.
GALSEN_HAARCASCADE_PATH=

# ---------------------------------------------------------------------------
# Stockage de fichiers (connecteur disque local — ADR-007)
# ---------------------------------------------------------------------------
# Répertoire où sont écrits les fichiers téléversés. Sans lui, le connecteur se
# déclare "non configuré" et le service de fichiers reste en mémoire : les
# fichiers disparaissent au redémarrage.
GALSEN_FILE_STORAGE_DIR=

# ---------------------------------------------------------------------------
# Posture de sécurité HTTP (VOLET 02 ch. 08)
# ---------------------------------------------------------------------------
# Origines autorisées à appeler l'API depuis un navigateur, séparées par des
# virgules. Vide = aucun appel croisé accepté, ce qui est le défaut sûr.
# Les appels serveur à serveur ne sont pas concernés.
#   Exemple : GALSEN_CORS_ORIGINS=https://galsen.sn,https://app.galsen.sn
GALSEN_CORS_ORIGINS=

# Proxys inverses dont les en-têtes X-Forwarded-For et X-Forwarded-Proto sont
# acceptés, séparés par des virgules. Adresses ou blocs CIDR.
# **Vide = aucun en-tête de transfert n'est cru**, et c'est le défaut sûr : sans
# proxy devant l'application, n'importe quel appelant peut envoyer ces en-têtes,
# changer d'adresse à chaque requête et obtenir un quota illimité tout en
# restant invisible du détecteur de menaces.
# Derrière Caddy en docker-compose : 172.16.0.0/12 (réseau bridge par défaut).
GALSEN_TRUSTED_PROXIES=

# ---------------------------------------------------------------------------
# Recherche sémantique (ADR-015)
# ---------------------------------------------------------------------------
# Sans encodeur installé, toute la récupération est **lexicale** : deux textes
# qui disent la même chose avec d'autres mots ne se rapprochent pas. Chaque
# réponse de recherche indique la méthode employée, donc l'absence se voit.
#
#     pip install -r requirements-embeddings.txt
#
# Attention au vrai prix : sentence-transformers tire PyTorch (~200 Mo en roue
# CPU). C'est pourquoi il n'est pas dans requirements.txt et pas dans l'image.
# `false` garde la récupération lexicale même si la bibliothèque est installée.
GALSEN_EMBEDDINGS_ENABLED=true
# Modèle d'encodage. Le défaut est multilingue et couvre le français.
GALSEN_EMBEDDING_MODEL=

# ---------------------------------------------------------------------------
# Base de connaissances
# ---------------------------------------------------------------------------
# Compte les consultations, qui alimentent le critère de popularité du
# classement. `false` rend le chemin de lecture réellement en lecture seule —
# ce que le compteur empêchait, puisqu'il écrivait à chaque résultat de
# recherche. Le signal de popularité est alors perdu, et c'est le prix annoncé.
GALSEN_KNOWLEDGE_TRACK_ACCESS=true

# ---------------------------------------------------------------------------
# Entrées non textuelles (VOLET 32)
# ---------------------------------------------------------------------------
# Transcription parole vers texte, en local. Sans `faster-whisper` installé
# (`requirements-audio.txt`), un fichier audio est **refusé** à l'ingestion en le
# disant — jamais traité comme un document vide.
# `false` coupe la transcription sans rien désinstaller : l'interrupteur de
# l'exploitant l'emporte sur tout fournisseur injecté par le code.
GALSEN_TRANSCRIPTION_ENABLED=true
# Taille du modèle Whisper : tiny, base, small, medium, large-v3.
# `small` comprend le français et tient sur une machine modeste.
GALSEN_WHISPER_MODEL=small

# Souveraineté des modèles (ADR-014)
# ---------------------------------------------------------------------------
# GalSen IA ne dépend d'aucun modèle tiers à l'exécution. En mode souverain —
# le défaut — les fournisseurs OpenAI, Anthropic et Google ne sont **pas
# inscrits** au registre : une clé héritée ou recopiée d'un autre projet ne
# peut donc pas faire sortir une requête de votre infrastructure.
# Restent le serveur local (Ollama) et tout serveur au format compatible que
# vous hébergez — vLLM, llama.cpp, LM Studio.
# `false` réinscrit les fournisseurs tiers : utile pour comparer un modèle
# propre à une référence pendant l'évaluation, et pour rien d'autre.
GALSEN_SOVEREIGN_MODE=true

# ---------------------------------------------------------------------------
# Instance unique (ADR-013)
# ---------------------------------------------------------------------------
# Au démarrage, l'application prend un verrou exclusif sur le répertoire de
# données. Une deuxième instance sur le même répertoire refuse de démarrer :
# les révocations de clés et les compteurs de quota vivent dans la mémoire du
# processus, donc deux instances, c'est deux vérités, et la plus permissive
# gagne — une clé révoquée sur l'une continue d'ouvrir l'autre.
# `true` lève le verrou en connaissance de cause. C'est le retour arrière.
GALSEN_ALLOW_MULTI_INSTANCE=false

# ---------------------------------------------------------------------------
# Terminaison TLS (Caddy — ADR-012)
# ---------------------------------------------------------------------------
# Domaine servi par Caddy. `localhost` fait émettre un certificat interne, utile
# pour un essai local ; un vrai domaine déclenche Let's Encrypt.
GALSEN_DOMAIN=
# Adresse de contact pour les avertissements d'expiration de certificat.
GALSEN_TLS_EMAIL=

# Documentation interactive (/docs, /redoc, /openapi.json).
# Vide = automatique : servie tant qu'aucune clé API n'est configurée, fermée
# dès qu'il y en a une. `enabled` ou `disabled` pour trancher explicitement.
GALSEN_API_DOCS=

# ---------------------------------------------------------------------------
# Chiffrement au repos (VOLET 02 ch. 08)
# ---------------------------------------------------------------------------
# Chiffre le contenu des mémoires et des connaissances dans les bases SQLite.
# Vide = inactif. Produire une clé :
#   python -c "from src.storage.encryption import generate_key; print(generate_key())"
#
# ATTENTION : perdre cette clé, c'est perdre les données chiffrées. Aucune
# récupération n'est possible. Sauvegardez-la séparément des bases.
#
# Activer le chiffrement sur une base existante ne casse rien : les anciennes
# lignes restent lisibles, les nouvelles écritures sont protégées.
GALSEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Données et instance
# ---------------------------------------------------------------------------
# Répertoire des bases SQLite et des fichiers de données (ADR-005). Défaut : data/
GALSEN_DATA_DIR=
# Répertoire des sauvegardes produites par scripts/backup.py. Défaut : data/backups.
# Le placer hors du volume de données est ce qui les fait survivre à sa perte.
GALSEN_BACKUP_DIR=

# Identifiant de cette instance, repris dans les journaux et /health. Défaut : le
# nom d'hôte. Utile dès qu'il y a plus d'une instance (ADR-009).
GALSEN_INSTANCE_ID=

# ---------------------------------------------------------------------------
# Journalisation (rotation, VOLET 04 critère C5)
# ---------------------------------------------------------------------------
# Taille maximale d'un fichier de journal avant rotation, en octets. Défaut : 5 Mo.
GALSEN_LOG_MAX_BYTES=
# Nombre d'archives conservées. Défaut : 3, soit 20 Mo au total avec la valeur ci-dessus.
GALSEN_LOG_BACKUP_COUNT=

# ---------------------------------------------------------------------------
# Gouvernance de la connaissance et de la recherche (VOLET 05 ch. 06, VOLET 14 ch. 08)
# ---------------------------------------------------------------------------
# Responsable par domaine de connaissance : "domaine:sujet,domaine:sujet".
# Domaines : business, technical, operational, legal, ai, user_documentation,
# project_documentation. Une entrée illisible est ignorée, jamais devinée.
GALSEN_KNOWLEDGE_OWNERS=
# Responsable par source de recherche : "source:sujet". Sources : knowledge,
# memory, document, vision.
GALSEN_SEARCH_OWNERS=
# Âge maximal d'une approbation avant revalidation, en jours. Défaut : 180.
GALSEN_KNOWLEDGE_REVALIDATION_DAYS=

# ---------------------------------------------------------------------------
# Détection de menaces (VOLET 11 ch. 05)
# ---------------------------------------------------------------------------
# Fenêtre d'observation des échecs d'authentification, en secondes. Défaut : 300.
GALSEN_THREAT_WINDOW_SECONDS=
# Nombre d'échecs dans la fenêtre à partir duquel une source est signalée sur
# /security/threats. Défaut : 10. Un seuil trop bas crie au loup et finit
# désactivé ; une valeur illisible ou nulle retombe sur le défaut.
GALSEN_THREAT_FAILURE_THRESHOLD=

# ---------------------------------------------------------------------------
# Cycle de vie des notifications (VOLET 13 ch. 03)
# ---------------------------------------------------------------------------
# Fenêtre pendant laquelle une notification identique et non lue est regroupée
# plutôt que dupliquée, en secondes. Défaut : 300. Une alerte qui se répète
# incrémente `occurrences` au lieu de noyer la boîte du destinataire.
GALSEN_NOTIFICATION_DEDUP_SECONDS=
# Âge au-delà duquel une notification **lue** peut être purgée, en jours.
# Défaut : 90. Les non lues ne sont jamais purgées automatiquement.
GALSEN_NOTIFICATION_RETENTION_DAYS=

# ---------------------------------------------------------------------------
# Magasin du service Cloud (VOLET 24 ch. 03)
# ---------------------------------------------------------------------------
# Choix du magasin pour le service Cloud seulement : in-memory (défaut),
# sqlite, filesystem, s3. Prime sur GALSEN_STORAGE_BACKEND, car `filesystem` et
# `s3` n'ont de sens que pour ce service. Une valeur inconnue est signalée au
# démarrage et le magasin par défaut s'applique.
# Le mode `s3` lit en plus CLOUD_S3_BUCKET, CLOUD_S3_ACCESS_KEY,
# CLOUD_S3_SECRET_KEY, CLOUD_S3_ENDPOINT, CLOUD_S3_REGION, CLOUD_S3_DATA_DIR.
GALSEN_CLOUD_BACKEND=

# ---------------------------------------------------------------------------
# Magasin du service de fichiers (ADR-016)
# ---------------------------------------------------------------------------
# Choix du magasin pour le service de fichiers seulement : in-memory (défaut),
# sqlite, filesystem, s3. Prime sur GALSEN_STORAGE_BACKEND, pour la même raison
# que ci-dessus. Une valeur inconnue est signalée et le défaut s'applique.
#
# ADR-016 fait de ce service le seul chemin d'écriture de fichiers de la
# plateforme : c'est ici que `filesystem` et `s3` doivent être déclarés, et
# GALSEN_CLOUD_BACKEND ne sert plus qu'aux routes /cloud/*, dépréciées.
#
# `filesystem` écrit dans GALSEN_DATA_DIR/files ; `s3` lit CLOUD_S3_BUCKET,
# CLOUD_S3_ACCESS_KEY, CLOUD_S3_SECRET_KEY, CLOUD_S3_ENDPOINT, CLOUD_S3_REGION.
GALSEN_FILE_BACKEND=

# ---------------------------------------------------------------------------
# Outils externes
# ---------------------------------------------------------------------------
# Jeton GitHub pour l'outil `github`. Vide = l'outil reste indisponible.
GALSEN_GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Serveur local (serveur_cerveau.py)
# ---------------------------------------------------------------------------
HOTE=0.0.0.0
PORT=8000
OLLAMA_URL=http://localhost:11434
MODELE=qwen2.5-coder:14b
LOG_LEVEL=info
