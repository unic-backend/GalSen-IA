# =============================================================================
# GalSen IA — Variables d'environnement
# =============================================================================
# Copier ce fichier vers .env et ajuster les valeurs selon votre environnement.
#   cp .env.example .env
#
# Ne JAMAIS commiter le fichier .env dans le dépôt Git.
# =============================================================================

# ---------------------------------------------------------------------------
# Stockage
# ---------------------------------------------------------------------------
# Backend de stockage : "sqlite" (persistant) ou "in-memory" (volatile)
GALSEN_STORAGE_BACKEND=sqlite

# ---------------------------------------------------------------------------
# Sécurité API
# ---------------------------------------------------------------------------
# Clés API autorisées, séparées par des virgules.
# Chaque client doit inclure sa clé dans l'en-tête X-API-Key.
GALSEN_API_KEYS=dev-key-1,dev-key-2

# ---------------------------------------------------------------------------
# Limiteur de taux
# ---------------------------------------------------------------------------
# Active/désactive le limiteur de taux ("true"/"false")
GALSEN_RATE_LIMIT_ENABLED=true

# Requêtes par minute pour les clients authentifiés (clé API valide)
GALSEN_RATE_LIMIT_AUTHENTICATED_RPM=60

# Requêtes par minute pour les clients non authentifiés (par IP)
GALSEN_RATE_LIMIT_UNAUTHENTICATED_RPM=30

# Multiplicateur de rafale (pics temporaires autorisés au-dessus de la limite RPM)
GALSEN_RATE_LIMIT_BURST_MULTIPLIER=2.0

# ---------------------------------------------------------------------------
# Ports
# ---------------------------------------------------------------------------
# Port HTTP du service principal (utilisé par docker-compose)
GALSEN_PORT=8000

# Port HTTP du service de développement (utilisé par docker-compose)
GALSEN_DEV_PORT=8001

# ---------------------------------------------------------------------------
# Fournisseurs de modèles IA
# ---------------------------------------------------------------------------
# OpenAI
OPENAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Google (Gemini)
GOOGLE_API_KEY=

# Ollama (modèles locaux) — URL du serveur, ex: http://host.docker.internal:11434
OLLAMA_HOST=

# ---------------------------------------------------------------------------
# Dépendances optionnelles des outils
# ---------------------------------------------------------------------------
# Pour l'outil OCR (pytesseract) : chemin vers l'exécutable Tesseract
# TESSERACT_CMD=/usr/bin/tesseract

# Pour l'outil GitHub : token d'accès personnel
# GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Messagerie (connecteur e-mail SMTP — ADR-007)
# ---------------------------------------------------------------------------
# Seul l'hôte est indispensable : un relais interne peut n'exiger aucune
# authentification. Sans GALSEN_SMTP_HOST, le connecteur se déclare simplement
# "non configuré" et la plateforme fonctionne normalement.
#
# Exemple pour Gmail : host=smtp.gmail.com, security=starttls, port=587,
# et un « mot de passe d'application », jamais le mot de passe du compte.
GALSEN_SMTP_HOST=
# Laisser vide pour déduire le port du mode de sécurité (587, 465 ou 25)
GALSEN_SMTP_PORT=
GALSEN_SMTP_USER=
GALSEN_SMTP_PASSWORD=
# Adresse d'expédition ; à défaut, GALSEN_SMTP_USER est utilisé
GALSEN_SMTP_SENDER=
# starttls (défaut, recommandé) | ssl | none
GALSEN_SMTP_SECURITY=

# ---------------------------------------------------------------------------
# Vision — détection de visages (optionnel)
# ---------------------------------------------------------------------------
# Chemin d'un fichier de cascade de Haar OpenCV
# (haarcascade_frontalface_default.xml). Les distributions
# `opencv-python-headless` récentes ne le livrent plus. Sans ce fichier, la
# détection de visages se déclare indisponible au lieu de répondre « aucun
# visage », ce qui serait un faux négatif présenté comme un résultat.
GALSEN_HAARCASCADE_PATH=

# ---------------------------------------------------------------------------
# Stockage de fichiers (connecteur disque local — ADR-007)
# ---------------------------------------------------------------------------
# Répertoire où sont écrits les fichiers téléversés. Sans lui, le connecteur se
# déclare "non configuré" et le service de fichiers reste en mémoire : les
# fichiers disparaissent au redémarrage.
GALSEN_FILE_STORAGE_DIR=
