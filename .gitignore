# Bases de donnees locales : la donnee ne se versionne pas
data/

# Corpus wolof brut : reproductible par `python scripts/ingest_wolof.py`.
# Le corpus **traité** (data/processed_wolof/) est versionné, lui : c'est ce que
# les tests et le RAG lisent.
data/raw_wolof/*.conllu

# Limites administratives brutes (Git LFS, ~3 Mo) : reproductibles par
# `python scripts/ingest_all_senegal.py`. La connaissance dérivée
# (data/processed_senegal/) est versionnée, elle.
data/raw_senegal/*.geojson
data/raw_senegal/*.csv
data/raw_senegal/*.json

# `data/` ci-dessus exclut le répertoire entier, et git ne redescend pas dans un
# répertoire exclu : une négation ne suffirait pas. Les connaissances **dérivées**
# sont donc suivies explicitement (`git add -f`), comme le sont déjà
# `data/processed_senegal/` et `data/processed_wolof/` :
#   data/processed_global/world_countries.json  (VOLET 52)
# Reproductible par `python scripts/build_world_knowledge.py`.

# Espaces isolés des réparations automatiques (VOLET 72)
.worktrees/

# Artefact non explique, apparu pendant une session (30/08/2026) : aucune
# reference dans le code, aucun historique. Ignore plutot que commite tel
# quel — a documenter ou supprimer une fois son origine confirmee.
config/permissions.yaml

# Sauvegardes et correctifs locaux. Git est déjà la sauvegarde : un `.patch`
# de 61 Ko a été commité à la racine le 2026-08-23, et il dupliquait ce que
# l'historique portait déjà. Retiré du suivi le 2026-08-24 ; toujours
# récupérable par `git show 1ba9bd9:sauvegarde-avant-probleme-1.patch`.
*.patch
*.diff
*.orig
*.rej
